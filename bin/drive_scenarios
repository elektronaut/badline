#!/usr/bin/env ruby
# frozen_string_literal: true

# Headless runner for the true-drive scenarios in test/support/drive_scenarios.rb:
# the C64 and a true 1541 running the real DOS ROM through a save, a
# format, the error channel, the idle loop, a write-protected disk and an
# autostart.
#
#   ruby --yjit bin/drive_scenarios [filter...] [--list] [--results PATH]
#                                   [--shards N] [--engine BINARY]
#
# Each scenario runs in a process of its own, spinel/drive_scenarios.rb on
# CRuby, with up to --shards of them side by side (SHARDS in the
# environment, 4 by default, capped by the core count). --engine runs a
# Spinel build of spinel/drive_scenarios.rb in their place, so the rows
# come from the same code either way. Each process gets a scratch
# directory for the disk images it writes.
#
# A scenario prints one tab-separated "scenario/check STATUS [detail]"
# record per check, the baseline format `rake regression:drive-scenarios`
# diffs against test/baselines/drive-scenarios.txt. With --results, the
# records are written to PATH in scenario order. A scenario whose process
# fails gets a FAIL row for each check it didn't report. Filters are
# scenario name substrings matched as a union; one that matches nothing is
# an error rather than an empty run.

require_relative "../test/support/drive_scenarios_runner"

exit DriveScenarios.main(ARGV)
