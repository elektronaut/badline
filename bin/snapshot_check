#!/usr/bin/env ruby
# frozen_string_literal: true

# Checks that snapshots restore the machine exactly, on the scenarios in
# test/support/snapshot_machines.rb: a C64 with each kind of media and
# expansion, the VIC-20, the C128, the Plus/4 and the C16, and the PETs.
#
#   ruby --yjit bin/snapshot_check [filter] [--cycles N] [--every K]
#   ruby --yjit bin/snapshot_check --vice [filter]
#   ruby --yjit bin/snapshot_check --carts [filter]
#   ruby --yjit bin/snapshot_check --write DIR [filter]
#   ruby --yjit bin/snapshot_check --read DIR [filter]
#   ruby --yjit bin/snapshot_check --diff A.vsf B.vsf
#   ruby --yjit bin/snapshot_check --fields FILE.vsf
#   ruby --yjit bin/snapshot_check --list
#
# For each scenario it builds the machine, runs it to the save point and
# saves it twice in a row (b1, then b1 again), loads b1 into a new machine
# and saves that (b2):
#
# - identity: b1 and b2 are the same bytes, and saving twice leaves the
#   machine alone (the two b1s match)
# - divergence: the saved machine and the loaded one run side by side for
#   --cycles, with a checkpoint (Badline::Support::Checkpoint and the true
#   drive's digest) every --every cycles, and then both are saved and the
#   snapshots compared
#
# Where two snapshots differ it names the module, and in a BL-* module the
# keys whose records differ.
#
# --vice checks the divergence of the PET and CBM-II scenarios through
# xpet's or xcbm2's modules: it saves each with VICE's modules
# (Snapshot::Vice::PET, Snapshot::Vice::CBM2), loads a new machine from
# those alone, and runs the two side by side. The first checkpoint comes
# after the picture, which a load from VICE's modules paints again, has
# caught up. What VICE's modules don't carry, such as a CBM-II's mains,
# which xcbm2 ticks where its CRTC says (Snapshot::Vice::CBM2::Mains),
# is taken to what a load from them makes of it before the machine is
# saved, and a PET's 2031 keeps its disk.
#
# --carts saves every cartridge mapper's module after register writes,
# reads and freezes (test/support/snapshot_cartridges.rb), builds a
# cartridge afresh from it, loads it, and saves that again.
#
# --write DIR saves each scenario's snapshot as DIR/<scenario>.vsf, runs
# the machine on for --cycles and writes its text screen to
# DIR/<scenario>.txt. --read DIR loads those snapshots into this tree,
# runs each for --cycles and compares the screen, so --write on another
# checkout and --read here checks that this badline reads its snapshots.
#
# --diff compares two snapshot files module by module, and --fields lists
# a snapshot's modules and their records.
#
# The exit status is 1 when anything differs.

require "fileutils"
require "optparse"
require "tmpdir"
require_relative "../test/support/jit"

options = { cycles: 2_000_000, every: 500_000 }
parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/snapshot_check [filter] [options]"
  opts.on("--cycles N", Integer, "Cycles to run after the save point (default: 2000000)") { |n| options[:cycles] = n }
  opts.on("--every K", Integer, "Cycles between checkpoints (default: 500000)") { |n| options[:every] = n }
  opts.on("--vice", "Check the PET and CBM-II scenarios through VICE's modules alone") { options[:mode] = :vice }
  opts.on("--carts", "Check every cartridge mapper's state") { options[:mode] = :carts }
  opts.on("--write DIR", "Save each scenario's snapshot and screen into DIR") do |dir|
    options[:mode] = :write
    options[:dir] = dir
  end
  opts.on("--read DIR", "Load DIR's snapshots, run them and compare the screens") do |dir|
    options[:mode] = :read
    options[:dir] = dir
  end
  opts.on("--diff", "Compare the two snapshot files named") { options[:mode] = :diff }
  opts.on("--fields", "List the modules and records of the snapshot file named") { options[:mode] = :fields }
  opts.on("--list", "List the scenarios") { options[:mode] = :list }
end

begin
  parser.parse!
rescue OptionParser::ParseError => e
  abort "snapshot_check: #{e.message}\n#{parser.banner}"
end
abort "snapshot_check: --every must be positive" unless options[:every].positive?

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
Jit.enable
require "badline"
require "badline/support"
require_relative "../test/support/snapshot_machines"
require_relative "../test/support/snapshot_cartridges"
require_relative "../test/support/snapshot_tracing"

module SnapshotCheck
  module_function

  def dump(machine) = Badline::Snapshot.dump(machine)

  def image(bytes) = Badline::Snapshot::Image.new(Badline::Snapshot::Container.parse(bytes))

  # A new machine from the snapshot `bytes`, and the lines its restore
  # left out.
  def load(bytes)
    ignored = []
    machine = image(bytes).load { |line| ignored << line }
    [machine, ignored]
  end

  def family_options(machine) = { family: machine.family.to_s, model: (machine.model.name if machine.family == :cbm2) }

  def checkpoint(machine)
    line = MachineFamilies.checkpoint(family_options(machine)).take(machine).to_s
    drive = TrueDrive.digest(machine)
    drive ? "#{line} #{TrueDrive.field(drive)}" : line
  end

  # The text screen in RAM: 40 by 25 at $0400 on a C64 or a C128 and at
  # $0C00 on the 264 series, on a VIC-20 22 by 23 at the page the KERNAL
  # keeps in $0288, on a PET 40 or 80 by 25 in its screen RAM, and on a
  # CBM-II 80 by 25, or 40 by 25 on a P500, at $D000 of segment 15.
  def screen(machine)
    if machine.family == :pet
      return screen_text(machine.bus.screen.cells, machine.model.video == :crtc80 ? 80 : 40, 25)
    end

    if machine.family == :cbm2
      columns = machine.bus.screen.length == 0x400 ? 40 : 80
      return screen_text(Array.new(columns * 25) { |index| machine.bus.screen.peek(0xd000 + index) }, columns, 25)
    end

    ram = machine.ram
    base, columns, rows = case machine.family
                          when :vic20 then [ram.peek(0x0288) << 8, 22, 23]
                          when :plus4 then [0x0c00, 40, 25]
                          else [0x0400, 40, 25]
                          end
    screen_text(Array.new(rows * columns) { |index| ram.peek(base + index) }, columns, rows)
  end

  def screen_text(codes, columns, rows)
    Array.new(rows) do |row|
      Array.new(columns) { |column| screen_char(codes[(row * columns) + column]) }.join.rstrip
    end.join("\n")
  end

  def screen_char(code)
    code &= 0x7f
    return "@" if code.zero?
    return (code + 96).chr if code < 27
    return code.chr if code < 64

    " "
  end

  def run(machine, cycles)
    cycles.times { machine.cycle! }
  end

  # Identity and divergence for one scenario. Returns whether it passed.
  def restores?(scenario, options)
    Dir.mktmpdir do |dir|
      machine = scenario.build.call(dir)
      scenario.advance.call(machine)
      first = dump(machine)
      again = dump(machine)
      restored, ignored = load(first)
      second = dump(restored)
      puts "#{scenario.name}: saved at cycle #{machine.cycles}, #{first.bytesize} bytes"
      ignored.each { |line| puts "  left out: #{line}" }
      [identical?(first, again, second), runs_alike?(machine, restored, options)].all?
    end
  end

  def identical?(first, again, second)
    [passed?("saving twice", SnapshotTracing.differences(first, again)),
     passed?("save, load, save", SnapshotTracing.differences(first, second))].all?
  end

  def passed?(what, lines)
    puts "  #{what}: #{lines.empty? ? 'identical' : 'DIFFERS'}"
    lines.each { |line| puts "    #{line}" }
    lines.empty?
  end

  # Runs both machines side by side, then saves both, which settles each
  # the same way while they still agree.
  def runs_alike?(machine, restored, options)
    every = options[:every]
    (options[:cycles] / every).times do
      run(machine, every)
      run(restored, every)
      ours = checkpoint(machine)
      theirs = checkpoint(restored)
      next if ours == theirs

      return passed?("run on", ["at cycle #{machine.cycles}", "saved:    #{ours}", "restored: #{theirs}"])
    end
    passed?("run on #{options[:cycles]} cycles", SnapshotTracing.differences(dump(machine), dump(restored)))
  end

  # A new machine from the VICE modules alone of the machine's snapshot
  # for VICE, and the lines its restore left out. A true drive keeps its
  # disks, which VICE's modules don't carry: they are restored
  # into a copy of the machine, as into a running machine.
  def load_vice(machine)
    sections = Badline::Snapshot::Image.exported(machine).sections.reject { |section| section.name.start_with?("BL-") }
    container = Badline::Snapshot::Container.new(sections, machine: Badline::Snapshot::Image.machine_name(machine))
    ignored = []
    vice = Badline::Snapshot::Image.new(container)
    return [vice.load { |line| ignored << line }, ignored] unless machine.true_drive

    restored = load(dump(machine)).first
    vice.restore(restored) { |line| ignored << line }
    [restored, ignored]
  end

  # Why VICE's modules can't carry the machine, or nil: a tape, a disk or
  # a cartridge, or a CBM-II 700 at 60 Hz, which xcbm2 doesn't build.
  def unsaved(machine)
    return "its media" if machine.mounted?
    return unsaved_pet(machine) if machine.family == :pet
    return "a 700 at 60 Hz" if machine.model.respond_to?(:high_profile) && machine.model.high_profile &&
                               machine.mains_hz == 60

    ram = machine.save_modules.find { |section| section.name == "BL-RAM" }
    Badline::Snapshot::Keyed::Reader.parse(ram).ints("cartridge.addresses", []).empty? ? nil : "its media"
  end

  def unsaved_pet(machine) = machine.cassettes.datasette1.tape ? "its media" : nil

  # The records VICE's modules don't carry, by module: the cycles a CPU has
  # run, which a P500's VIC stalls it for, a CBM-II's mains, which xcbm2
  # ticks where its CRTC says, its DRAM refresh's count, the last byte on
  # its bus, the keys the host has yet to type, now or once booted, and its
  # TPIs' priority stacks, and the phase a 2031's stepper is offset by, with the port
  # that drives it (Snapshot::Vice::PET::Drive2031). An 8050's controller
  # comes back as a unit switched on has it, whole
  # (Snapshot::Vice::PET::Drive8050), and a P500's VIC as xcbm5x0's
  # line-based VIC-II leaves it, whole (Snapshot::Vice::P500::VICII).
  UNSAVED = { "BL-MACHINE" => %w[mains_countdown mains_high refresh host.pending_keys
                                 host.init_keys], "BL-RAM" => %w[data],
              "BL-TPI1" => %w[stack], "BL-TPI2" => %w[stack], "BL-D8-MECH" => %w[slip], "BL-D8-VIA2" => %w[orb],
              "BL-CPU" => %w[cycles] }.freeze
  CONTROLLER = %w[BL-D8 BL-D8-FDCCPU BL-D8-VIA BL-D8-RRIOT BL-D8-MECH].freeze

  # The modules a load from VICE's modules makes afresh, whole.
  def remade(machine)
    return CONTROLLER if %w[8050 8250].include?(machine.true_drive&.model_name)
    return %w[BL-VIC] if machine.is_a?(Badline::CBM2::P500)

    []
  end

  # Takes the machine's state that VICE's modules don't carry (UNSAVED) to
  # what a load from them makes of it. Each module gains those records of
  # the load's, which count over its own.
  def conform(machine)
    theirs = load_vice(machine).first.save_modules
    sections = machine.save_modules.map do |section|
      other = theirs.find { |each| each.name == section.name }
      next other if other && remade(machine).include?(section.name)

      keys = UNSAVED.fetch(section.name, [])
      next section if keys.empty? || other.nil?

      section.with(data: Zlib.deflate(Zlib.inflate(section.data) + records(other, keys)))
    end
    machine.load_modules(Badline::Snapshot::Keyed::Modules.new(sections))
  end

  # The records `keys` name in `section`, encoded as they stand.
  def records(section, keys)
    reader = Badline::Snapshot::Keyed::Reader.parse(section)
    out = Badline::Snapshot::Keyed::Writer.new
    keys.each do |key|
      case reader.tags[key]
      when Badline::Snapshot::Keyed::INT then out.int(key, reader.int(key, 0))
      when Badline::Snapshot::Keyed::BOOL then out.bool(key, reader.bool(key, false))
      when Badline::Snapshot::Keyed::INTS then out.ints(key, reader.ints(key, []))
      when nil then out.ints(key, []) if key.start_with?("host.")
      end
    end
    out.to_s
  end

  # Divergence through xpet's or xcbm2's modules for one PET or CBM-II
  # scenario, at each checkpoint: VICE's modules don't carry what badline
  # keeps for itself alone, such as its instruction count. A scenario
  # they can't carry either (#unsaved) is skipped. Returns whether it
  # passed.
  def restores_through_vice?(scenario, options)
    Dir.mktmpdir do |dir|
      machine = scenario.build.call(dir)
      scenario.advance.call(machine)
      emulator = Badline::Snapshot::Image.vice_emulator(machine)
      reason = unsaved(machine)
      next puts("#{scenario.name}: skipped, as #{emulator}'s modules don't carry #{reason}") || true if reason

      conform(machine)
      restored, ignored = load_vice(machine)
      puts "#{scenario.name}: saved for #{emulator} at cycle #{machine.cycles}"
      ignored.each { |line| puts "  left out: #{line}" }
      checkpoints_alike?(machine, restored, options)
    end
  end

  def checkpoints_alike?(machine, restored, options)
    every = options[:every]
    (options[:cycles] / every).times do
      run(machine, every)
      run(restored, every)
      ours = checkpoint(machine)
      theirs = checkpoint(restored)
      next if ours == theirs

      return passed?("run on", ["at cycle #{machine.cycles}", "saved:    #{ours}", "restored: #{theirs}"])
    end
    passed?("run on #{options[:cycles]} cycles", [])
  end

  def carts_identical?(filter)
    scenarios = SnapshotCartridges.scenarios.select { |name, _| filter.nil? || name.include?(filter) }
    failed = scenarios.reject do |name, cartridge|
      ours = SnapshotCartridges.save(cartridge)
      theirs = SnapshotCartridges.save(SnapshotCartridges.round_trip(cartridge))
      lines = SnapshotTracing.module_difference("BL-CART", ours, theirs)
      lines.each { |line| puts "#{name}: #{line}" }
      lines.empty?
    end
    puts "#{scenarios.size - failed.size} of #{scenarios.size} cartridges save, load and save identically"
    failed.empty?
  end

  def write(scenarios, options)
    FileUtils.mkdir_p(options[:dir])
    scenarios.each do |scenario|
      Dir.mktmpdir do |dir|
        machine = scenario.build.call(dir)
        scenario.advance.call(machine)
        path = File.join(options[:dir], "#{scenario.name}.vsf")
        machine.save_snapshot(path)
        run(machine, options[:cycles])
        File.write(File.join(options[:dir], "#{scenario.name}.txt"), screen(machine))
        puts "#{scenario.name}: #{path}"
      end
    end
  end

  def reads_back?(filter, options)
    paths = Dir[File.join(options[:dir], "*.vsf")]
    paths.select! { |path| File.basename(path).include?(filter) } if filter
    paths.map { |path| reads_back_one?(path, options) }.all?
  end

  def reads_back_one?(path, options)
    name = File.basename(path, ".vsf")
    machine, ignored = load(File.binread(path))
    ignored.each { |line| puts "#{name}: left out: #{line}" }
    run(machine, options[:cycles])
    expected = File.join(File.dirname(path), "#{name}.txt")
    return passed?(name, []) unless File.exist?(expected)

    shown = screen(machine)
    passed?(name, shown == File.read(expected) ? [] : ["the screen after #{options[:cycles]} cycles:", shown])
  rescue Badline::Snapshot::FormatError => e
    passed?(name, ["won't load: #{e.message}"])
  end

  def same_files?(first, second)
    passed?("#{first} against #{second}", SnapshotTracing.differences(File.binread(first), File.binread(second)))
  end
end

passed =
  case options[:mode]
  when :list then SnapshotMachines.all.each { |scenario| puts scenario.name }
  when :carts then SnapshotCheck.carts_identical?(ARGV.first)
  when :vice
    scenarios = SnapshotMachines.matching(ARGV.first).select { |scenario| %i[pet cbm2].include?(scenario.family) }
    abort "snapshot_check: no PET or CBM-II scenario matches #{ARGV.first}" if scenarios.empty?
    results = scenarios.map { |scenario| SnapshotCheck.restores_through_vice?(scenario, options) }
    puts "#{results.count(true)} of #{results.size} scenarios run on alike through VICE's modules"
    results.all?
  when :write
    SnapshotCheck.write(SnapshotMachines.matching(ARGV.first), options)
    true
  when :read then SnapshotCheck.reads_back?(ARGV.first, options)
  when :diff
    abort "snapshot_check: --diff takes two snapshot files" unless ARGV.length == 2
    SnapshotCheck.same_files?(*ARGV)
  when :fields
    abort "snapshot_check: --fields takes one snapshot file" unless ARGV.length == 1
    puts SnapshotTracing.fields(File.binread(ARGV.first))
    true
  else
    scenarios = SnapshotMachines.matching(ARGV.first)
    abort "snapshot_check: no scenario matches #{ARGV.first}" if scenarios.empty?
    results = scenarios.map { |scenario| SnapshotCheck.restores?(scenario, options) }
    puts "#{results.count(true)} of #{results.size} scenarios restore exactly"
    results.all?
  end
exit(passed ? 0 : 1)
