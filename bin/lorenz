#!/usr/bin/env ruby
# frozen_string_literal: true

# Headless runner for the Wolfgang Lorenz C64 Emulator Test Suite.
#
#   ruby --yjit bin/lorenz [image] [start_test] [max_cycles] [--results PATH]
#                          [--resume NAME] [--stop-after NAME]
#
# Boots the machine, mounts the image as device 8 and autostarts (or loads
# start_test by name to resume mid-suite; --resume NAME does the same
# without naming the image). Lorenz.d81 holds disks 1-3 of the suite, and
# the chain carries on onto Disk4.d64 the way a user with the four disks
# would: when the next test is missing from the mounted image but is on
# Disk4.d64 beside it, that disk goes into the drive before the LOAD is
# served. Test output is captured through the CHROUT trap and echoed to
# stdout, and nothing reads the display, so the VIC leaves its colours
# unpainted. When a failed test halts waiting for a keypress (detected by
# GETIN polling), a space is injected to continue — STOP would exit some
# tests to BASIC and kill the chain. Ends once `finish` prints the suite
# completion message and its "- ok", on a BASIC READY prompt, on a hard
# hang, or with --stop-after once the chain has moved past the named test.
#
# The suite chains itself by LOADing one test after another, so the names
# it asks the mounted image for — and the transcript offsets they arrive
# at — split the capture into one segment per test. With --results, those
# become a tab-separated "name STATUS [detail]" record per test, the same
# baseline format bin/testbench writes; the full transcript goes to
# tmp/lorenz/transcript.txt for diagnosing what a changed row means. A run
# that stops or times out leaves its last segment cut short, so that one
# is left out of the results.
#
# A resumed test's segment also carries the READY prompt and the typed
# LOAD, so its row differs from the one the chain records. See
# `rake regression:lorenz` for diffing a run against the tracked baseline
# in test/baselines/, and `rake "regression:record:lorenz[first,last]"`
# for re-recording a stretch of the chain.
#
# The machine-driving half lives in test/lorenz_chain.rb, which Spinel
# compiles too (spinel/lorenz.rb), and the rows come from test/lorenz_run.rb.

lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
require "badline"
require "fileutils"
require_relative "../test/lorenz_chain"
require_relative "../test/lorenz_run"

module Lorenz
  ARTIFACT_DIR = File.expand_path("../tmp/lorenz", __dir__)

  class << self
    # Removes "--name value" or "--name=value" from argv, returning the value.
    def take_option(argv, name)
      index = argv.index { |arg| arg == name || arg.start_with?("#{name}=") }
      return unless index

      arg = argv.delete_at(index)
      arg.start_with?("#{name}=") ? arg.split("=", 2).last : argv.delete_at(index)
    end

    def screen_ascii(code)
      code &= 0x7f
      case code
      when 0x01..0x1a then (code + 0x60).chr
      when 0x00, 0x1b..0x1f then (code + 0x40).chr
      when 0x20..0x3f, 0x41..0x5a then code.chr
      else " "
      end
    end

    # Runs the chain, echoing the transcript as it grows.
    def drive(chain)
      until chain.result
        text = chain.step
        next if text.empty?

        print text
        $stdout.flush
      end
    end

    def write_results(path, run)
      write(path, run.records.join("\n"))
    end

    def write_transcript(run)
      path = File.join(ARTIFACT_DIR, "transcript.txt")
      write(path, run.transcript)
      path
    end

    def write(path, text)
      FileUtils.mkdir_p(File.dirname(path))
      File.write(path, text.end_with?("\n") ? text : "#{text}\n")
    end

    def dump_screen(computer)
      warn "=== screen RAM ==="
      25.times do |row|
        warn computer.ram.read(0x0400 + (row * 40), 40)
                     .map { |code| screen_ascii(code) }.join
      end
    end
  end
end

if $PROGRAM_NAME == __FILE__
  results_path = Lorenz.take_option(ARGV, "--results")
  resume = Lorenz.take_option(ARGV, "--resume")
  stop_after = Lorenz.take_option(ARGV, "--stop-after")
  image = ARGV[0] || Lorenz::DEFAULT_IMAGE
  start_test = resume || ARGV[1]
  max_cycles = (ARGV[2] || 10_000_000_000).to_i

  computer = Badline::Computer.new
  computer.vic.render = false
  capture = computer.capture_output
  disk = Lorenz.mount(computer, image, capture, start_test)
  warn "Mounted #{image} as device 8"

  chain = Lorenz::Chain.new(computer, capture, disk, max_cycles, stop_after)
  Lorenz.drive(chain)
  result = chain.result
  run = Lorenz::Run.new(capture.output, disk.names.zip(disk.offsets), chain.key_offsets, result)

  warn "Transcript written to #{Lorenz.write_transcript(run)}"
  Lorenz.write_results(results_path, run) if results_path
  Lorenz.dump_screen(computer) unless %w[completed stopped].include?(result)
  warn "[#{result}] #{computer.cycles} cycles, #{chain.keys_sent} keys sent"
  exit(%w[completed ready-prompt stopped].include?(result) ? 0 : 1)
end
