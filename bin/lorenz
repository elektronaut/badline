#!/usr/bin/env ruby
# frozen_string_literal: true

# Headless runner for the Wolfgang Lorenz C64 Emulator Test Suite.
#
#   ruby --yjit bin/lorenz [image] [start_test] [max_cycles] [--results PATH]
#                          [--resume NAME] [--stop-after NAME] [--plus4]
#
# Boots the machine, mounts the image as device 8 and autostarts (or loads
# start_test by name to resume mid-suite; --resume NAME does the same
# without naming the image). Lorenz.d81 holds disks 1-3 of the suite, and
# the chain carries on onto Disk4.d64 the way a user with the four disks
# would: when the next test is missing from the mounted image but is on
# Disk4.d64 beside it, that disk goes into the drive before the LOAD is
# served. Test output is captured through the CHROUT trap and echoed to
# stdout, and nothing reads the display, so the VIC leaves its colours
# unpainted. When a failed test halts waiting for a keypress (detected by
# GETIN polling), a space is injected to continue — STOP would exit some
# tests to BASIC and kill the chain. Ends once `finish` prints the suite
# completion message and its "- ok", on a BASIC READY prompt, on a hard
# hang, or with --stop-after once the chain has moved past the named test.
#
# The suite chains itself by LOADing one test after another, so the names
# it asks the mounted image for — and the transcript offsets they arrive
# at — split the capture into one segment per test. With --results, those
# become a tab-separated "name STATUS [detail]" record per test, the same
# baseline format bin/testbench writes; the full transcript goes to
# tmp/lorenz/transcript.txt for diagnosing what a changed row means. A run
# that stops or times out leaves its last segment cut short, so that one
# is left out of the results.
#
# A resumed test's segment also carries the READY prompt and the typed
# LOAD, so its row differs from the one the chain records. See
# `rake regression:lorenz` for diffing a run against the tracked baseline
# in test/baselines/, and `rake "regression:record:lorenz[first,last]"`
# for re-recording a stretch of the chain.
#
# --plus4 runs the suite's plus4 build on a PAL Plus/4 instead:
# LorenzPlus4.d81, carrying on onto Disk4plus4.d64. Its programs report
# through $FDCF, which nothing reads here, and the transcript is the same
# CHROUT capture. readme-plus4.txt names the tests that can't pass on the
# 264: trap1-trap17, branchwrap, mmufetch, mmu, cpuport and cputiming, and
# nmi on a CPU without NMI. Some of those stop the chain, so when it hangs,
# drops to READY, halts for keys more than Lorenz::PLUS4_KEY_LIMIT times in
# one test or runs one test past Lorenz::PLUS4_TEST_CYCLE_LIMIT cycles, a
# fresh machine resumes it at the program after the one it
# stuck on, in the order the disks hold them (Lorenz.segments), and the
# (suite) row names the programs it resumed past.
#
# The machine-driving half lives in test/support/lorenz_chain.rb, which Spinel
# compiles too (spinel/lorenz.rb), and the rows come from test/support/lorenz_run.rb.

lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
require "badline"
require "fileutils"
require_relative "../test/support/cli"
require_relative "../test/support/lorenz_chain"
require_relative "../test/support/lorenz_run"
require_relative "../test/support/testbench_machine"
require_relative "../test/support/testbench_plus4_machine"

module Lorenz
  ARTIFACT_DIR = File.expand_path("../tmp/lorenz", __dir__)

  class << self
    # Runs the chain, echoing the transcript as it grows.
    def drive(chain)
      until chain.result
        text = chain.step
        next if text.empty?

        print text
        $stdout.flush
      end
    end

    def write_results(path, run)
      write(path, run.records.join("\n"))
    end

    def write_transcript(run)
      path = File.join(ARTIFACT_DIR, "transcript.txt")
      write(path, run.transcript)
      path
    end

    def write(path, text)
      FileUtils.mkdir_p(File.dirname(path))
      File.write(path, text.end_with?("\n") ? text : "#{text}\n")
    end

    def dump_screen(computer)
      warn "=== screen RAM ==="
      screen = if computer.is_a?(Badline::Plus4) then Testbench.plus4_screen_text(computer)
               else Testbench.screen_text(computer.ram)
               end
      screen.each { |line| warn line }
    end

    # The machine the chain runs on, a PAL Plus/4 for the plus4 build or a
    # C64, its picture left unpainted.
    def machine(plus4)
      return Badline::Plus4.new.tap { |computer| computer.ted.render = false } if plus4

      Badline::C64.new.tap { |computer| computer.vic.render = false }
    end
  end
end

if $PROGRAM_NAME == __FILE__
  results_path = CLI.take_option(ARGV, "--results")
  resume = CLI.take_option(ARGV, "--resume")
  stop_after = CLI.take_option(ARGV, "--stop-after")
  plus4 = !ARGV.delete("--plus4").nil?
  image = ARGV[0] || (plus4 ? Lorenz::PLUS4_IMAGE : Lorenz::DEFAULT_IMAGE)
  start_test = resume || ARGV[1]
  max_cycles = (ARGV[2] || 10_000_000_000).to_i

  next_disk = plus4 ? Lorenz::PLUS4_NEXT_DISK : Lorenz::NEXT_DISK
  computer = nil
  keys_sent = 0
  run_chain = lambda do |start|
    computer = Lorenz.machine(plus4)
    capture = computer.capture_output
    disk = Lorenz.mount(computer, image, capture, start, next_disk)
    warn "Mounted #{image} as device 8#{", resuming at #{start}" if start}"
    chain = Lorenz::Chain.new(computer, capture, disk, max_cycles, stop_after)
    if plus4
      chain.key_limit = Lorenz::PLUS4_KEY_LIMIT
      chain.test_cycle_limit = Lorenz::PLUS4_TEST_CYCLE_LIMIT
    end
    Lorenz.drive(chain)
    keys_sent += chain.keys_sent
    Lorenz::Run.new(capture.output, disk.names.zip(disk.offsets), chain.key_offsets, chain.result)
  end
  run = if plus4 then Lorenz.segments(Lorenz::Resumption.for(image, next_disk), start_test, &run_chain)
        else run_chain.call(start_test)
        end
  result = run.result

  warn "Transcript written to #{Lorenz.write_transcript(run)}"
  Lorenz.write_results(results_path, run) if results_path
  Lorenz.dump_screen(computer) unless %w[completed stopped].include?(result)
  warn "[#{result}] #{computer.cycles} cycles, #{keys_sent} keys sent"
  exit(%w[completed ready-prompt stopped].include?(result) ? 0 : 1)
end
