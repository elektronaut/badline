#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs a scenario and prints a Badline::Checkpoint every K cycles: one
# digest each for the CPU, RAM, colour RAM, the framebuffer, and the VIC,
# CIA and SID registers, and with --true-drive one for the drive. Two runs
# that print the same lines left the machine in the same state at every
# checkpoint.
#
#   ruby --yjit bin/machine_diff [scenario|media] [--cycles N] [--every K]
#   ruby --yjit bin/machine_diff [scenario|media] --save FILE
#   ruby --yjit bin/machine_diff [scenario|media] --against REV|FILE
#   ruby --yjit bin/machine_diff [scenario|media] --restore-at CYCLE
#   ruby --yjit bin/machine_diff [scenario|media] --family vic20 [--ram RAM]
#   ruby --yjit bin/machine_diff [scenario|media] --family c128 [--mode c64|c128]
#
# Scenarios:
#   boot   power on and sit at the READY prompt
#   type   boot, then type `print 6*7` (or --text) at the prompt
#   demo   a program built here: a raster IRQ that changes the background
#          colour, eight sprites, a sounding SID voice and CIA 2 timer A,
#          started with RUN
#   disk   the demo program in a host directory mounted as device 8,
#          loaded through the KERNAL traps with LOAD"*",8,1 and RUN
# Anything else is a path handed to Badline::Media.attach: a PRG, a disk
# or tape image, a CRT or a directory.
#
# --family picks the machine: c64 (the default), vic20 or c128, with
# --model naming its model (Badline::Machine.build). Each family runs the
# same scenarios with a demo of its own:
#
#   vic20  a PAL VIC-20 with the RAM --ram names, or the RAM the media
#          needs (Badline::Media.vic20_ram_for), unexpanded otherwise.
#          The demo hooks the KERNAL's VIA 2 IRQ to cycle the screen and
#          border colours and a voice's pitch, sounds two voices and the
#          noise, and runs VIA 1 timer 1 free. The disk scenario loads it
#          with LOAD"*",8. Checkpoints digest the CPU, RAM, colour RAM,
#          display, the VIC-I, both VIAs and the sound
#          (Badline::Vic20Checkpoint), with the sound recording so its
#          voices run
#   c128   a C128 in the mode --mode names, c128 (the default) or c64. In
#          C64 mode the demo is the C64's. In C128 mode it is the same
#          program at $1C0D, its IRQ also writing the VDC's colour
#          register and the MMU's PCRB. Checkpoints digest the C64's
#          components, all 128K of RAM, and the VDC's registers, the VDC's
#          RAM, the MMU and the Z80 (Badline::C128Checkpoint)
#
# --true-drive plugs a Drive1541 into the serial bus before the machine
# boots, and adds its digest to each checkpoint as drive=. A D64 then
# goes into the drive instead of Media.attach, and the machine types
# LOAD"$",8 and LIST (or --text) once booted, so the directory comes off
# the disk through the DOS. --no-idle-skip makes the drive run every
# cycle of its idle loop (see Drive::Idle), so running the same tree
# with and without it checks that skipping leaves the drive and the
# machine alone:
#
#   ruby --yjit bin/machine_diff disk.d64 --true-drive --save skip.txt
#   ruby --yjit bin/machine_diff disk.d64 --true-drive --no-idle-skip --against skip.txt
#
# --against REV extracts REV's lib/ into tmp/machine_diff/<sha>/, runs the
# same scenario on it alongside this run and stops at the first
# checkpoint that differs, naming the components that differ. --against
# FILE compares with lines saved by --save. Either way the exit status is
# 1 on a difference. The run for REV goes under the JIT this one runs
# under: --zjit, --yjit, or none on TruffleRuby. Without either flag,
# CRuby enables YJIT at startup.
#
# --restore-at CYCLE saves a .vsf snapshot at CYCLE, restores it into a
# second machine built for the same scenario, and runs the two side by
# side, stopping at the first checkpoint where they differ.

require "English"
require "fileutils"
require "optparse"
require "rbconfig"
require "tmpdir"
require_relative "../test/support/jit"
require_relative "../test/support/true_drive"

# 10 SYS2061, then the demo at $080D. The IRQ handler sits at $0885.
DEMO_PRG = [
  0x01, 0x08, # load address
  0x0b, 0x08, 0x0a, 0x00, 0x9e, 0x32, 0x30, 0x36, 0x31, 0x00, 0x00, 0x00,
  0x78,                   # sei
  0xa9, 0x7f,             # lda #$7f
  0x8d, 0x0d, 0xdc,       # sta $dc0d
  0xad, 0x0d, 0xdc,       # lda $dc0d
  0xa9, 0x01,             # lda #$01
  0x8d, 0x1a, 0xd0,       # sta $d01a
  0xa9, 0x1b,             # lda #$1b
  0x8d, 0x11, 0xd0,       # sta $d011
  0xa9, 0x80,             # lda #$80
  0x8d, 0x12, 0xd0,       # sta $d012
  0xa9, 0x85,             # lda #<irq
  0x8d, 0x14, 0x03,       # sta $0314
  0xa9, 0x08,             # lda #>irq
  0x8d, 0x15, 0x03,       # sta $0315
  0xa2, 0x3f,             # ldx #$3f
  0x8a,                   # txa
  0x9d, 0x40, 0x03,       # sta $0340,x
  0xca,                   # dex
  0x10, 0xf9,             # bpl $0831
  0xa2, 0x0f,             # ldx #$0f
  0x8a,                   # txa
  0x0a, 0x0a, 0x0a, 0x0a, # asl x4
  0x69, 0x30,             # adc #$30
  0x9d, 0x00, 0xd0,       # sta $d000,x
  0xca,                   # dex
  0x10, 0xf3,             # bpl $083a
  0xa2, 0x07,             # ldx #$07
  0xa9, 0x0d,             # lda #$0d
  0x9d, 0xf8, 0x07,       # sta $07f8,x
  0x8a,                   # txa
  0x9d, 0x27, 0xd0,       # sta $d027,x
  0xca,                   # dex
  0x10, 0xf4,             # bpl $0849
  0xa9, 0xff,             # lda #$ff
  0x8d, 0x15, 0xd0,       # sta $d015
  0x8d, 0x1c, 0xd0,       # sta $d01c
  0xa9, 0x0f,             # lda #$0f
  0x8d, 0x18, 0xd4,       # sta $d418
  0xa9, 0x10,             # lda #$10
  0x8d, 0x01, 0xd4,       # sta $d401
  0xa9, 0x09,             # lda #$09
  0x8d, 0x05, 0xd4,       # sta $d405
  0xa9, 0x21,             # lda #$21
  0x8d, 0x04, 0xd4,       # sta $d404
  0xa9, 0xff,             # lda #$ff
  0x8d, 0x04, 0xdd,       # sta $dd04
  0x8d, 0x05, 0xdd,       # sta $dd05
  0xa9, 0x11,             # lda #$11
  0x8d, 0x0e, 0xdd,       # sta $dd0e
  0x58,                   # cli
  0xee, 0x00, 0x04,       # inc $0400
  0x4c, 0x7f, 0x08,       # jmp $087f
  0xee, 0x19, 0xd0,       # irq: inc $d019
  0xee, 0x21, 0xd0,       # inc $d021
  0xe6, 0xfb,             # inc $fb
  0xa5, 0xfb,             # lda $fb
  0x8d, 0x01, 0xd4,       # sta $d401
  0xad, 0x12, 0xd0,       # lda $d012
  0x49, 0x40,             # eor #$40
  0x8d, 0x12, 0xd0,       # sta $d012
  0x4c, 0x81, 0xea        # jmp $ea81
].pack("C*").freeze

# The C128 mode demo: 10 SYS7181, then DEMO_PRG's program at $1C0D, with
# the sprites at $0E00, the IRQ handler at $1C85 and the KERNAL's IRQ exit
# at $FF33. The handler also writes VDC register 26 and the MMU's PCRB.
C128_DEMO_PRG = [
  0x01, 0x1c, # load address
  0x0b, 0x1c, 0x0a, 0x00, 0x9e, 0x37, 0x31, 0x38, 0x31, 0x00, 0x00, 0x00,
  0x78,                   # sei
  0xa9, 0x7f,             # lda #$7f
  0x8d, 0x0d, 0xdc,       # sta $dc0d
  0xad, 0x0d, 0xdc,       # lda $dc0d
  0xa9, 0x01,             # lda #$01
  0x8d, 0x1a, 0xd0,       # sta $d01a
  0xa9, 0x1b,             # lda #$1b
  0x8d, 0x11, 0xd0,       # sta $d011
  0xa9, 0x80,             # lda #$80
  0x8d, 0x12, 0xd0,       # sta $d012
  0xa9, 0x85,             # lda #<irq
  0x8d, 0x14, 0x03,       # sta $0314
  0xa9, 0x1c,             # lda #>irq
  0x8d, 0x15, 0x03,       # sta $0315
  0xa2, 0x3f,             # ldx #$3f
  0x8a,                   # txa
  0x9d, 0x00, 0x0e,       # sta $0e00,x
  0xca,                   # dex
  0x10, 0xf9,             # bpl $1c31
  0xa2, 0x0f,             # ldx #$0f
  0x8a,                   # txa
  0x0a, 0x0a, 0x0a, 0x0a, # asl x4
  0x69, 0x30,             # adc #$30
  0x9d, 0x00, 0xd0,       # sta $d000,x
  0xca,                   # dex
  0x10, 0xf3,             # bpl $1c3a
  0xa2, 0x07,             # ldx #$07
  0xa9, 0x38,             # lda #$38
  0x9d, 0xf8, 0x07,       # sta $07f8,x
  0x8a,                   # txa
  0x9d, 0x27, 0xd0,       # sta $d027,x
  0xca,                   # dex
  0x10, 0xf4,             # bpl $1c49
  0xa9, 0xff,             # lda #$ff
  0x8d, 0x15, 0xd0,       # sta $d015
  0x8d, 0x1c, 0xd0,       # sta $d01c
  0xa9, 0x0f,             # lda #$0f
  0x8d, 0x18, 0xd4,       # sta $d418
  0xa9, 0x10,             # lda #$10
  0x8d, 0x01, 0xd4,       # sta $d401
  0xa9, 0x09,             # lda #$09
  0x8d, 0x05, 0xd4,       # sta $d405
  0xa9, 0x21,             # lda #$21
  0x8d, 0x04, 0xd4,       # sta $d404
  0xa9, 0xff,             # lda #$ff
  0x8d, 0x04, 0xdd,       # sta $dd04
  0x8d, 0x05, 0xdd,       # sta $dd05
  0xa9, 0x11,             # lda #$11
  0x8d, 0x0e, 0xdd,       # sta $dd0e
  0x58,                   # cli
  0xee, 0x00, 0x04,       # inc $0400
  0x4c, 0x7f, 0x1c,       # jmp $1c7f
  0xee, 0x19, 0xd0,       # irq: inc $d019
  0xee, 0x21, 0xd0,       # inc $d021
  0xe6, 0xfb,             # inc $fb
  0xa5, 0xfb,             # lda $fb
  0x8d, 0x01, 0xd4,       # sta $d401
  0xad, 0x12, 0xd0,       # lda $d012
  0x49, 0x40,             # eor #$40
  0x8d, 0x12, 0xd0,       # sta $d012
  0xa2, 0x1a,             # ldx #$1a
  0x8e, 0x00, 0xd6,       # stx $d600
  0x2c, 0x00, 0xd6,       # bit $d600
  0x10, 0xfb,             # bpl $1c9f
  0xa5, 0xfb,             # lda $fb
  0x8d, 0x01, 0xd6,       # sta $d601
  0x8d, 0x02, 0xd5,       # sta $d502
  0x4c, 0x33, 0xff        # jmp $ff33
].pack("C*").freeze

# The VIC-20 demo: 10 SYS4109, then the demo at $100D, for an unexpanded
# VIC-20. The IRQ handler sits at $103B and goes on to the KERNAL's at
# $EABF.
VIC20_DEMO_PRG = [
  0x01, 0x10, # load address
  0x0b, 0x10, 0x0a, 0x00, 0x9e, 0x34, 0x31, 0x30, 0x39, 0x00, 0x00, 0x00,
  0x78,                   # sei
  0xa9, 0x3b,             # lda #<irq
  0x8d, 0x14, 0x03,       # sta $0314
  0xa9, 0x10,             # lda #>irq
  0x8d, 0x15, 0x03,       # sta $0315
  0xa9, 0x0f,             # lda #$0f
  0x8d, 0x0e, 0x90,       # sta $900e
  0xa9, 0xc0,             # lda #$c0
  0x8d, 0x0b, 0x90,       # sta $900b
  0xa9, 0xf0,             # lda #$f0
  0x8d, 0x0d, 0x90,       # sta $900d
  0xa9, 0x40,             # lda #$40
  0x8d, 0x1b, 0x91,       # sta $911b
  0xa9, 0xff,             # lda #$ff
  0x8d, 0x14, 0x91,       # sta $9114
  0x8d, 0x15, 0x91,       # sta $9115
  0x58,                   # cli
  0xee, 0x00, 0x1e,       # inc $1e00
  0x4c, 0x35, 0x10,       # jmp $1035
  0xee, 0x0f, 0x90,       # irq: inc $900f
  0xe6, 0xfb,             # inc $fb
  0xa5, 0xfb,             # lda $fb
  0x09, 0x80,             # ora #$80
  0x8d, 0x0c, 0x90,       # sta $900c
  0x4c, 0xbf, 0xea        # jmp $eabf
].pack("C*").freeze

module MachineDiff
  ROOT = File.expand_path("..", __dir__)
  SCENARIOS = %w[boot type demo disk].freeze

  # The machine --family, --model, --mode and --ram build, its demo, and the
  # checkpoint that digests it.
  module Families
    NAMES = %w[c64 vic20 c128].freeze
    MODES = %w[c128 c64].freeze

    module_function

    # The machine for the options, with a true drive plugged in if they ask.
    # `media` is the path a scenario attaches, or nil. A C64 without a model
    # named is built as TrueDrive builds it.
    def build(options, media)
      family = options[:family]
      return TrueDrive.computer(options) if family == "c64" && options[:model].nil?

      machine = case family
                when "vic20" then vic20(options, media)
                when "c128" then Badline::C128.new(model: options[:model] || "c128", mode: options[:mode].to_sym)
                else Badline::Machine.build(:c64, model: options[:model])
                end
      plug_drive(machine, options) if options[:true_drive]
      machine
    end

    def vic20(options, media)
      ram = options[:ram]&.to_sym || (media ? Badline::Media.vic20_ram_for(media) : :unexpanded)
      machine = Badline::Machine.build(:vic20, model: options[:model] || "pal", ram:)
      machine.sound_source.record(rate: 44_100)
      machine
    end

    def plug_drive(machine, options)
      drive = Badline::Drive1541.new
      drive.idle_skip = options[:idle_skip] if drive.respond_to?(:idle_skip=)
      machine.attach_drive1541(drive)
    end

    def demo(options)
      case options[:family]
      when "vic20" then VIC20_DEMO_PRG
      when "c128" then options[:mode] == "c128" ? C128_DEMO_PRG : DEMO_PRG
      else DEMO_PRG
      end
    end

    # Writes the demo into `dir` as demo.prg, and returns its path.
    def write_demo(dir, options)
      path = File.join(dir, "demo.prg")
      File.binwrite(path, demo(options))
      path
    end

    # What loads and runs the demo from device 8.
    def disk_text(options)
      return Badline::Media::AUTOSTART unless options[:family] == "vic20"

      Badline::Media::Vic20Media.disk_autostart(VIC20_DEMO_PRG.bytes)
    end

    # What takes and parses the family's checkpoints.
    def checkpoint(options)
      case options[:family]
      when "vic20" then Badline::Vic20Checkpoint
      when "c128" then Badline::C128Checkpoint
      else Badline::Checkpoint
      end
    end

    # The machine's checkpoint. The VIC-20 first drains the sound it records.
    def take(machine, options)
      machine.sound_source.drain_samples if options[:family] == "vic20"
      checkpoint(options).take(machine)
    end

    # The options that reach the run on another revision.
    def flags(options)
      ["--family", options[:family], *(["--model", options[:model]] if options[:model]),
       "--mode", options[:mode], *(["--ram", options[:ram]] if options[:ram])]
    end

    # --family, --model, --mode and --ram, and the scenarios, for --help.
    def define_options(opts, options)
      opts.on("--family FAMILY", "The machine: #{NAMES.join(', ')} (default: c64)") { |name| options[:family] = name }
      opts.on("--model MODEL", "The family's model, as Badline::Machine.build names it") do |model|
        options[:model] = model
      end
      opts.on("--mode MODE", "The C128's mode: #{MODES.join(', ')} (default: c128)") { |mode| options[:mode] = mode }
      opts.on("--ram RAM", "The VIC-20's RAM expansion (default: what the media needs)") { |ram| options[:ram] = ram }
      opts.separator ""
      opts.separator "Scenarios, on every family: boot, type (--text at the prompt), demo (a program built"
      opts.separator "here for the family, and for the C128's mode) and disk (the demo loaded from a host"
      opts.separator "directory as device 8). Anything else is media for Badline::Media.attach. The"
      opts.separator "comment at the top of bin/machine_diff says what each family's demo does and digests."
    end

    # Why the options don't make a machine, or nil.
    def invalid(options)
      family = options[:family]
      return "no family named #{family} (#{NAMES.join(', ')})" unless NAMES.include?(family)
      return "no C128 mode named #{options[:mode]} (#{MODES.join(', ')})" unless MODES.include?(options[:mode])

      "--ram is the VIC-20's" if options[:ram] && family != "vic20"
    end
  end

  module_function

  # The readers a checkpoint takes, for a revision from before the chips had them.
  def backport_readers
    unless Badline::VIC.method_defined?(:register_file)
      Badline::VIC.class_eval { def register_file = Array.new(0x40) { |reg| @registers[reg] } }
    end
    Badline::CIA.class_eval { def time_of_day = @tod } unless Badline::CIA.method_defined?(:time_of_day)
    return if Badline::TimeOfDay.method_defined?(:registers)

    Badline::TimeOfDay.class_eval do
      def registers
        [@clock[:tenths], @clock[:seconds], @clock[:minutes], @clock[:hours],
         @alarm[:tenths], @alarm[:seconds], @alarm[:minutes], @alarm[:hours],
         @stopped ? 1 : 0, @latch ? 1 : 0]
      end
    end
  end

  def machine(scenario, options, dir)
    computer = Families.build(options, SCENARIOS.include?(scenario) ? nil : scenario)
    case scenario
    when "boot" then nil
    when "type" then computer.on_init { computer.type_text(options[:text]) }
    when "demo" then Badline::Media.attach(computer, Families.write_demo(dir, options))
    when "disk"
      Families.write_demo(dir, options)
      Badline::Media.attach(computer, dir)
      computer.type_text(Families.disk_text(options))
    else TrueDrive.insert(computer, scenario, options) || Badline::Media.attach(computer, scenario, **options[:media])
    end
    computer
  end

  # Yields a checkpoint every options[:every] cycles, up to options[:cycles].
  def run(scenario, options)
    Dir.mktmpdir do |dir|
      computer = machine(scenario, options, dir)
      every = options[:every]
      (options[:cycles] / every).times do
        every.times { computer.cycle! }
        yield Families.take(computer, options), TrueDrive.digest(computer)
      end
    end
  end

  def print_run(scenario, options)
    out = options[:save] ? File.open(options[:save], "w") : nil
    run(scenario, options) do |checkpoint, drive|
      puts TrueDrive.line(checkpoint, drive)
      $stdout.flush
      out&.puts(TrueDrive.line(checkpoint, drive))
    end
  ensure
    out&.close
  end

  def base_lib(rev)
    sha = IO.popen(["git", "-C", ROOT, "rev-parse", "--verify", "#{rev}^{commit}"], &:read).strip
    abort "machine_diff: unknown revision #{rev}" unless $CHILD_STATUS.success?
    dir = File.join(ROOT, "tmp/machine_diff", sha)
    unless File.directory?("#{dir}/lib")
      FileUtils.mkdir_p(dir)
      system("git -C #{ROOT} archive #{sha} lib | tar -x -C #{dir}", exception: true)
    end
    [sha, "#{dir}/lib"]
  end

  def child_command(scenario, options, lib)
    [RbConfig.ruby, *Jit.flags, __FILE__, scenario, "--lib", lib, *TrueDrive.flags(options), *Families.flags(options),
     "--cycles", options[:cycles].to_s, "--every", options[:every].to_s, "--text", options[:text]]
  end

  def compare(scenario, options)
    against = options[:against]
    if File.file?(against)
      puts "#{scenario} against #{against}"
      File.open(against) { |io| compare_with(scenario, options, io) }
    else
      sha, lib = base_lib(against)
      puts "#{scenario} against #{sha[0, 10]}"
      IO.popen(child_command(scenario, options, lib)) do |io|
        compare_with(scenario, options, io)
      ensure
        stop(io.pid)
      end
    end
  end

  def stop(pid)
    Process.kill("TERM", pid)
  rescue Errno::ESRCH
    nil
  end

  def compare_with(scenario, options, io)
    count = 0
    run(scenario, options) do |ours, drive|
      line = io.gets
      abort "machine_diff: the other run ended before cycle #{ours.cycle}" unless line

      theirs = Families.checkpoint(options).parse(line)
      report_difference(ours, theirs) unless ours == theirs
      puts TrueDrive.compare(ours, drive, line)
      count += 1
    end
    puts "#{count} checkpoints match"
  end

  def report_difference(ours, theirs)
    puts "  this run: #{ours}", "  against:  #{theirs}"
    differing = ours.cycle == theirs.cycle ? ours.differences(theirs).join(", ") : "cycle count"
    puts "First difference at cycle #{ours.cycle}: #{differing}"
    exit 1
  end

  # --restore-at: a machine and its restored snapshot, run side by side.
  module RestoreCheck
    module_function

    # Runs the scenario to options[:restore_at], restores a snapshot of it
    # into a second machine and checks the two run on alike.
    def restore_check(scenario, options)
      Dir.mktmpdir do |dir|
        computer = MachineDiff.machine(scenario, options, dir)
        options[:restore_at].times { computer.cycle! }
        path = File.join(dir, "machine_diff.vsf")
        computer.save_snapshot(path)
        restored = MachineDiff.machine(scenario, options, dir)
        restored.restore_snapshot(path) { |line| puts "  #{line}" }
        puts "#{scenario} restored from a snapshot at cycle #{options[:restore_at]} (#{File.size(path)} bytes)"
        compare_restored(computer, restored, options)
      end
    end

    def compare_restored(computer, restored, options)
      every = options[:every]
      count = 0
      ((options[:cycles] - options[:restore_at]) / every).times do
        every.times do
          computer.cycle!
          restored.cycle!
        end
        ours = Families.take(computer, options)
        theirs = Families.take(restored, options)
        MachineDiff.report_difference(ours, theirs) unless ours == theirs
        puts ours
        count += 1
      end
      puts "#{count} checkpoints match"
    end
  end
end

options = { cycles: 10_000_000, every: 1_000_000, text: "print 6*7\r", lib: File.join(MachineDiff::ROOT, "lib"),
            true_drive: false, idle_skip: true, media: {}, family: "c64", mode: "c128" }

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/machine_diff [#{MachineDiff::SCENARIOS.join('|')}|media] [options]"
  opts.on("--cycles N", Integer, "Cycles to run (default: 10000000)") { |n| options[:cycles] = n }
  opts.on("--every K", Integer, "Cycles between checkpoints (default: 1000000)") { |n| options[:every] = n }
  opts.on("--text TEXT", "What the type scenario, or a D64 with --true-drive, types") do |text|
    options[:text] = text
  end
  opts.on("--true-drive", "Plug a true 1541 in, and put a D64 in it") { options[:true_drive] = true }
  opts.on("--no-idle-skip", "Run every cycle of the true 1541's idle loop") { options[:idle_skip] = false }
  opts.on("--save FILE", "Also write the checkpoints to FILE") { |path| options[:save] = path }
  opts.on("--against REV_OR_FILE", "Compare with REV's lib/ or with a file from --save") do |against|
    options[:against] = against
  end
  opts.on("--lib DIR", "Load badline from DIR") { |dir| options[:lib] = File.expand_path(dir) }
  opts.on("--restore-at CYCLE", Integer, "Snapshot at CYCLE, restore and compare the two") do |cycle|
    options[:restore_at] = cycle
  end
  MachineDiff::Families.define_options(opts, options)
end

begin
  parser.parse!
rescue OptionParser::ParseError => e
  abort "machine_diff: #{e.message}\n#{parser.banner}"
end
abort "machine_diff: --every must be positive" unless options[:every].positive?
problem = MachineDiff::Families.invalid(options)
abort "machine_diff: #{problem}" if problem

scenario = ARGV.shift || "boot"
unless MachineDiff::SCENARIOS.include?(scenario)
  abort "machine_diff: no scenario or file named #{scenario}" unless File.exist?(scenario)

  scenario = File.expand_path(scenario)
end

$LOAD_PATH.unshift(options[:lib])
Jit.enable
require "badline"
# This tree's checkpoints digest the machine on either revision.
checkpoints = { Checkpoint: "checkpoint", Vic20Checkpoint: "vic20_checkpoint", C128Checkpoint: "c128_checkpoint" }
checkpoints.each do |name, file|
  path = File.expand_path("../lib/badline/#{file}.rb", __dir__)
  Badline.__send__(:remove_const, name) if Badline.const_defined?(name, false) && !$LOADED_FEATURES.include?(path)
  require path
end

MachineDiff.backport_readers
# A disk image mounts write-protected, so neither run writes to the file the
# other one reads. A revision from before `read_only` mounts it as it is.
if Badline::Storage::DiskImage.instance_method(:initialize).parameters.include?(%i[key read_only])
  options[:media] = { disk: { read_only: true } }
end

if options[:restore_at]
  MachineDiff::RestoreCheck.restore_check(scenario, options)
elsif options[:against]
  MachineDiff.compare(scenario, options)
else
  MachineDiff.print_run(scenario, options)
end
