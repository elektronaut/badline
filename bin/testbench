#!/usr/bin/env ruby
# frozen_string_literal: true

# Headless runner for the VICE testbench (vendor/VICE-testprogs).
#
#   ruby --yjit bin/testbench [filter...] [--scope PREFIX] [--exclude PREFIX]
#                             [--shards N] [--list] [--results PATH]
#
# Runs the non-interactive PAL tests from c64-testlist.in that cover
# hardware badline models: VICII, CIA, interrupts and CPU. Each test boots
# a fresh machine with its directory mounted as device 8, injects the .prg
# and types RUN. Tests report through the $D7FF debug register ($00 pass,
# $ff fail), unless the testlist says expect:error or expect:timeout;
# screenshot tests are compared pixel-by-pixel against the bundled
# reference PNGs (pepto palette, 384x272 — the same crop the GUI uses).
# Failure artifacts go to tmp/testbench/ — the mismatched screenshot for a
# screenshot test, the text screen for an exitcode one — and the results
# log, one tab-separated "id STATUS [detail]" record per test in testlist
# order, to --results (tmp/testbench/results.txt by default).
#
# --scope and --exclude bound the run to an id prefix, which is how the
# suites are split: `rake regression:testbench` scopes to VICII/ and diffs
# those rows against the tracked baseline in test/baselines/,
# `rake regression:testbench-cia` scopes to CIA/, and so on. Filters are a
# union matched inside that scope, so a filtered run stays in one
# baseline's rows; a filter that matches nothing is an error rather than
# an empty run.
#
# Tests are independent — each boots its own machine — so the run is
# forked over --shards processes (SHARDS in the environment, 4 by
# default) and the per-test records merged back into testlist order.

lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
require "badline"
require "chunky_png"
require "etc"
require "tmpdir"

module Testbench
  TESTBENCH_DIR = File.expand_path("../vendor/VICE-testprogs/testbench", __dir__)
  TESTLIST = File.join(TESTBENCH_DIR, "c64-testlist.in")
  ARTIFACT_DIR = File.expand_path("../tmp/testbench", __dir__)

  RUNNABLE_TYPES = %w[exitcode screenshot].freeze

  # The testlist subtrees for hardware badline models. CPU/decimalmode is
  # left out of CPU: 41 exhaustive ADC/SBC sweeps that SingleStepTests
  # already covers per-opcode against bus-level reference traces, for a
  # worst case near nine hours.
  INCLUDED_DIRS = %r{\A\.\./(VICII|CIA|interrupts|CPU)/}
  EXCLUDED_DIRS = %r{\A\.\./CPU/decimalmode/}

  # cia-new asks for the 6526A, whose one-cycle-shorter timer and shift
  # register behaviour badline does not model; the same programs are listed
  # again with cia-old, which is what it does model.
  SKIP_OPTIONS = /ntsc|drean|mount|cia-new/

  # Boot + RUN typing overhead on top of the testlist cycle budgets, which
  # assume VICE's own autostart.
  BOOT_ALLOWANCE = 3_000_000
  BATCH = 10_000

  # The VICE PAL viewport crop of the VIC display, matching the 384x272
  # reference screenshots (the GUI ScreenPane crops 4 lines lower).
  WIDTH = 384
  HEIGHT = 272
  COL_OFFSET = 96
  ROW_OFFSET = 16

  # Pepto PAL palette (pepto-pal.vpl), which the references are rendered in.
  PALETTE = [
    0x000000, 0xFFFFFF, 0x68372B, 0x70A4B2, 0x6F3D86, 0x588D43, 0x352879,
    0xB8C76F, 0x6F4F25, 0x433900, 0x9A6759, 0x444444, 0x6C6C6C, 0x9AD284,
    0x6C5EB5, 0x959595
  ].freeze

  # Removes "--name value" or "--name=value" from argv, returning the value.
  def self.take_option(argv, name)
    index = argv.index { |arg| arg == name || arg.start_with?("#{name}=") }
    return unless index

    arg = argv.delete_at(index)
    arg.start_with?("#{name}=") ? arg.split("=", 2).last : argv.delete_at(index)
  end

  TestCase = Struct.new(:dir, :prg, :type, :timeout, :options) do
    def id
      "#{dir.delete_prefix('../')}/#{prg}"
    end

    # A test may declare that failing, or never reporting at all, is the
    # pass. Default is a $00 exit code.
    def expects
      return :error if options.include?("expect:error")
      return :timeout if options.include?("expect:timeout")

      :success
    end

    # exit_code is nil when the test never wrote $D7FF within its budget.
    def satisfied_by?(exit_code)
      case expects
      when :error then !exit_code.nil? && !exit_code.zero?
      when :timeout then exit_code.nil?
      else exit_code&.zero?
      end
    end

    def dir_abs
      File.expand_path(dir, Testbench::TESTBENCH_DIR)
    end

    def reference
      File.join(dir_abs, "references", "#{prg}.png")
    end
  end

  module Testlist
    module_function

    # Filters are id substrings, matched as a union; no filter runs
    # everything inside the scope.
    def tests(filters, scope: nil, exclude: nil)
      File.readlines(TESTLIST)
          .filter_map { |line| parse(line) }
          .select { |test| selected?(test, filters, scope, exclude) }
    end

    def selected?(test, filters, scope, exclude)
      return false if scope && !test.id.include?(scope)
      return false if exclude && test.id.include?(exclude)

      filters.empty? || filters.any? { |filter| test.id.include?(filter) }
    end

    # Filters that picked up no test at all, which a typo makes silent.
    def unmatched(filters, tests)
      filters.reject { |filter| tests.any? { |test| test.id.include?(filter) } }
    end

    def parse(line)
      line = line.strip
      return if line.empty? || line.start_with?("#")

      dir, prg, type, timeout, *options = line.split(",")
      return unless dir.match?(INCLUDED_DIRS) && !dir.match?(EXCLUDED_DIRS)
      return unless RUNNABLE_TYPES.include?(type)
      return if options.any?(SKIP_OPTIONS)

      TestCase.new(dir.chomp("/"), prg, type, timeout.to_i, options)
    end
  end

  # Maps reference PNG pixels to C64 color indices by nearest palette entry.
  class ReferenceImage
    def initialize(path)
      @png = ChunkyPNG::Image.from_file(path)
      @indices = Hash.new { |cache, pixel| cache[pixel] = nearest(pixel) }
    end

    def size
      [@png.width, @png.height]
    end

    def row(line)
      Array.new(@png.width) { |x| @indices[@png[x, line]] }
    end

    private

    def nearest(pixel)
      rgb = [ChunkyPNG::Color.r(pixel), ChunkyPNG::Color.g(pixel),
             ChunkyPNG::Color.b(pixel)]
      (0..15).min_by { |i| distance(PALETTE[i], rgb) }
    end

    def distance(color, rgb)
      [(color >> 16) - rgb[0], ((color >> 8) & 0xff) - rgb[1],
       (color & 0xff) - rgb[2]].sum { |d| d * d }
    end
  end

  class Screenshot
    def self.capture(vic)
      new(Array.new(HEIGHT) do |row|
        vic.display[((row + ROW_OFFSET) * vic.width) + COL_OFFSET, WIDTH]
      end)
    end

    attr_reader :rows

    def initialize(rows)
      @rows = rows
    end

    # Returns the number of mismatched pixels and writes failure artifacts.
    def compare(test)
      reference = ReferenceImage.new(test.reference)
      return :ref_size unless reference.size == [WIDTH, HEIGHT]

      diff = HEIGHT.times.sum { |y| row_diff(reference.row(y), rows[y]) }
      write_artifacts(test, reference) if diff.positive?
      diff
    end

    private

    def row_diff(expected, actual)
      expected.each_index.count { |x| expected[x] != actual[x] }
    end

    def write_artifacts(test, reference)
      base = File.join(ARTIFACT_DIR, test.id.tr("/", "-"))
      to_png { |x, y| rows[y][x] }.save("#{base}.actual.png")
      to_png do |x, y|
        reference.row(y)[x] == rows[y][x] ? rows[y][x] : nil
      end.save("#{base}.diff.png")
    end

    # Builds a PNG from palette indices; nil pixels are marked red.
    def to_png(&)
      png = ChunkyPNG::Image.new(WIDTH, HEIGHT)
      HEIGHT.times do |y|
        WIDTH.times do |x|
          index = yield(x, y)
          rgb = index ? PALETTE[index] : 0xFF0000
          png[x, y] = ChunkyPNG::Color.rgb(rgb >> 16, (rgb >> 8) & 0xff, rgb & 0xff)
        end
      end
      png
    end
  end

  # Tests are independent, so a run is split over forked shards and the
  # per-test records merged back into testlist order. Indices are global to
  # the run, which is what survives the split.
  module Shards
    module_function

    # Longest budget first into the least loaded shard, each shard keeping
    # testlist order. An exitcode test ends when it reports, so the budget
    # is only an upper bound, but it is the one ordering available before
    # the run.
    def split(tests, count)
      groups = Array.new(count) { [] }
      loads = Array.new(count, 0)
      tests.each_with_index.sort_by { |test, _| -test.timeout }.each do |test, index|
        shard = loads.each_index.min_by { |n| loads[n] }
        groups[shard] << [index, test]
        loads[shard] += test.timeout
      end
      groups.each { |group| group.sort_by!(&:first) }
    end

    def record(index, result)
      "#{index}\t#{result}\n"
    end

    # The records every shard wrote, back in testlist order.
    def merge(lines)
      lines.map { |line| line.split("\t", 2) }
           .map { |index, result| [index.to_i, result] }
           .sort_by(&:first)
    end
  end

  class Runner
    # Left well short of the core count: several workspaces share the
    # machine, and a suite that hogs it helps nobody.
    DEFAULT_SHARDS = 4

    # --shards, else SHARDS in the environment, else the default, capped by
    # the cores actually available. Without fork there is one shard.
    def self.shard_count(requested)
      return 1 unless Process.respond_to?(:fork)

      count = (requested || ENV.fetch("SHARDS", nil)).to_i
      count = DEFAULT_SHARDS unless count.positive?
      [count, Etc.nprocessors].min
    end

    def initialize(tests, results_path, shards: 1)
      @tests = tests
      @results_path = results_path
      @shards = [shards, tests.length].min
      @results = []
    end

    def run
      FileUtils.mkdir_p(ARTIFACT_DIR)
      @started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      @shards > 1 ? run_sharded : run_serial
      summarize
      @results.count { |_, result| result != "PASS" }
    end

    private

    def run_serial
      @results = @tests.map { |test| [test, run_one(test)] }
    end

    # Each child owns a disjoint slice of the testlist and writes its own
    # records to a file. A child that dies without writing its slice would
    # silently shorten the results, so both the exit statuses and the
    # merged row count are checked.
    def run_sharded
      Dir.mktmpdir("shards", ARTIFACT_DIR) do |dir|
        groups = Shards.split(@tests, @shards)
        $stdout.flush
        groups.each_with_index { |group, n| fork { shard(group, File.join(dir, "#{n}.txt"), n) } }
        crashed = Process.waitall.count { |_, status| !status.success? }
        raise "#{crashed} of #{groups.length} testbench shards crashed." if crashed.positive?

        @results = collect(dir)
      end
      return if @results.length == @tests.length

      raise "Shards reported #{@results.length} of #{@tests.length} tests."
    end

    def shard(group, path, number)
      File.write(path, group.map { |index, test| Shards.record(index, run_one(test)) }.join)
      exit!(0)
    rescue StandardError, SystemStackError => e
      warn "shard #{number}: #{e.class}: #{e.message}"
      exit!(1)
    end

    def collect(dir)
      lines = Dir.glob(File.join(dir, "*.txt"))
                 .flat_map { |path| File.readlines(path, chomp: true) }
      Shards.merge(lines).map { |index, result| [@tests[index], result] }
    end

    def run_one(test)
      result, elapsed = timed { run_test(test) }
      report(test, result, elapsed)
      result
    end

    def timed
      started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      [yield, Process.clock_gettime(Process::CLOCK_MONOTONIC) - started]
    end

    def run_test(test)
      exit_code, computer = execute(test)
      return score_screenshot(test, exit_code, computer) unless test.type == "exitcode"

      score_exitcode(test, exit_code).tap do |result|
        write_screen(test, computer) unless result == "PASS"
      end
    end

    def score_exitcode(test, exit_code)
      return "PASS" if test.satisfied_by?(exit_code)

      detail = "exit=#{format_code(exit_code)}"
      test.expects == :success ? detail : "#{detail} want=#{test.expects}"
    end

    # An exitcode test prints what went wrong — the failing subtest, and
    # the reference and measured values — which the exit code alone does
    # not carry, so a failure keeps the text screen alongside it.
    def write_screen(test, computer)
      rows = Array.new(25) do |row|
        computer.ram.read(0x0400 + (row * 40), 40)
                .map { |code| screen_ascii(code) }.join
      end
      File.write(File.join(ARTIFACT_DIR, "#{test.id.tr('/', '-')}.screen.txt"),
                 "#{rows.join("\n")}\n")
    end

    def screen_ascii(code)
      code &= 0x7f
      case code
      when 0x01..0x1a then (code + 0x60).chr
      when 0x00, 0x1b..0x1f then (code + 0x40).chr
      when 0x20..0x3f, 0x41..0x5a then code.chr
      else " "
      end
    end

    def execute(test)
      computer = boot(test)
      exit_code = nil
      computer.install_debug_register { |value| exit_code = value }
      budget = test.timeout + BOOT_ALLOWANCE
      BATCH.times { computer.cycle! } until exit_code || computer.cycles > budget
      [exit_code, computer]
    end

    def boot(test)
      Badline::Computer.new.tap do |computer|
        computer.mount(Badline::Storage::HostDirectory.new(test.dir_abs))
        Badline::Media.attach(computer, File.join(test.dir_abs, test.prg))
      end
    end

    def score_screenshot(test, exit_code, computer)
      return "no-ref" unless File.exist?(test.reference)

      diff = Screenshot.capture(computer.vic).compare(test)
      return "ref-size" if diff == :ref_size
      return "PASS" if diff.zero?

      "diff=#{diff}px exit=#{format_code(exit_code)}"
    end

    def format_code(exit_code)
      exit_code ? format("$%02x", exit_code) : "none"
    end

    def report(test, result, elapsed)
      puts format("%-55<id>s %7.1<elapsed>fs %<result>s",
                  id: test.id, elapsed:, result:)
      $stdout.flush
    end

    def summarize
      passed = @results.count { |_, result| result == "PASS" }
      wall = Process.clock_gettime(Process::CLOCK_MONOTONIC) - @started
      puts format("%<passed>d/%<total>d passed in %<wall>.1f min",
                  passed:, total: @results.length, wall: wall / 60)
      FileUtils.mkdir_p(File.dirname(@results_path))
      File.write(@results_path,
                 @results.map { |test, result| record(test, result) }.join)
    end

    def record(test, result)
      result == "PASS" ? "#{test.id}\tPASS\n" : "#{test.id}\tFAIL\t#{result}\n"
    end
  end
end

require "fileutils"

if $PROGRAM_NAME == __FILE__
  list_only = ARGV.delete("--list")
  results_path = Testbench.take_option(ARGV, "--results") ||
                 File.join(Testbench::ARTIFACT_DIR, "results.txt")
  scope = Testbench.take_option(ARGV, "--scope")
  exclude = Testbench.take_option(ARGV, "--exclude")
  shards = Testbench::Runner.shard_count(Testbench.take_option(ARGV, "--shards"))
  tests = Testbench::Testlist.tests(ARGV, scope:, exclude:)

  unmatched = Testbench::Testlist.unmatched(ARGV, tests)
  unless unmatched.empty?
    warn "No test in #{scope || 'the testlist'} matches #{unmatched.join(', ')}."
    exit 2
  end

  if list_only
    tests.each { |test| puts "#{test.id} (#{test.type}, #{test.timeout})" }
    puts "#{tests.length} tests"
    exit
  end

  exit(Testbench::Runner.new(tests, results_path, shards:).run.zero? ? 0 : 1)
end
