#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints the spec files of one shard, for CI's RSpec matrix, split by the
# run times recorded in test/spec_times.json (test/spec_shards.rb).
#
#   bin/spec_shard [--slow] INDEX COUNT
#   bundle exec rspec $(bin/spec_shard 1 2)
#   bundle exec rspec --tag slow $(bin/spec_shard --slow 1 2)
#
# --record takes the times from the RSpec JSON formatter reports of a
# whole run, or of every shard of one, plain or with --slow for
# `rspec --tag slow`, in place of that run's times in test/spec_times.json:
#
#   bundle exec rspec --format progress --format json --out tmp/rspec.json
#   bin/spec_shard --record tmp/rspec.json
#
# Each CI shard keeps its report as the spec-times-<kind>-<shard> artifact:
#
#   gh run download RUN --pattern 'spec-times-plain-*' --dir tmp/times
#   bin/spec_shard --record tmp/times/*/*.json

require "json"
require_relative "../test/spec_shards"

TIMES = File.expand_path("../test/spec_times.json", __dir__)
ROOT = File.expand_path("..", __dir__)

kind = ARGV.delete("--slow") ? "slow" : "plain"
times = File.exist?(TIMES) ? JSON.parse(File.read(TIMES)) : {}

if ARGV.delete("--record")
  abort "usage: bin/spec_shard --record [--slow] REPORT..." if ARGV.empty?

  times[kind] = SpecShards.times_from(*ARGV.map { |report| File.read(report) })
  File.write(TIMES, "#{JSON.pretty_generate(times.sort.to_h)}\n")
else
  abort "usage: bin/spec_shard [--slow] INDEX COUNT" unless ARGV.length == 2

  files = Dir.chdir(ROOT) { Dir["spec/**/*_spec.rb"] }
  puts SpecShards.new(files, times.fetch(kind, {})).shard(Integer(ARGV[0]), Integer(ARGV[1]))
end
