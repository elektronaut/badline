#!/usr/bin/env ruby
# frozen_string_literal: true

# Headless runner for the SID testprogs in vendor/VICE-testprogs/SID.
#
#   ruby --jit bin/sidtests [filter] [--list] [--results PATH]
#
# Only the programs that report through the $D7FF debug register can be
# scored automatically ($00 pass, $ff fail); the rest print to the screen and
# need the eye. Each test boots a fresh machine, injects the .prg and types
# RUN. With --results, the results log — one tab-separated "name STATUS
# [detail]" record per test, in test order — is written to PATH; that is the
# baseline format `rake regression:sid` diffs against the tracked copy in
# test/baselines/.

lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
require "badline"
require "fileutils"

module SIDTests
  ROOT = File.expand_path("../vendor/VICE-testprogs/SID", __dir__)

  BOOT_ALLOWANCE = 3_000_000
  TIMEOUT = 12_000_000
  BATCH = 10_000

  TESTS = %w[
    busvalue/busvalue.prg
    envelope/lft-adsr-test.prg
    envelope/testADSRDelayBug.prg
    envelope/testFlip00toFF.prg
    envelope/testFlipFFto00.prg
    exp_counter_reset/env_test_exr.prg
    noiselfsrinit/simple.prg
    osc3-wave0/osc3-wave0.prg
    osc_topbit/osc_topbit_test_noise_old.prg
    osc_topbit/osc_topbit_test_pulse_old.prg
    osc_topbit/osc_topbit_test_triangle_old.prg
    oscinit/allinit.prg
    oscinit/noiseinit.prg
    oscinit/oscinit.prg
    ringmod/ringmodtest.prg
    wf12nsr/wf12nsr.prg
    writedelay/writedelay.prg
  ].freeze

  module_function

  # Removes "--name value" or "--name=value" from argv, returning the value.
  def take_option(argv, name)
    index = argv.index { |arg| arg == name || arg.start_with?("#{name}=") }
    return unless index

    arg = argv.delete_at(index)
    arg.start_with?("#{name}=") ? arg.split("=", 2).last : argv.delete_at(index)
  end

  def exit_code(name)
    computer = Badline::Computer.new
    Badline::Media.attach(computer, File.join(ROOT, name))
    code = nil
    computer.install_debug_register { |value| code = value }
    BATCH.times { computer.cycle! } until code || computer.cycles > TIMEOUT + BOOT_ALLOWANCE
    code
  end

  def score(name)
    code = exit_code(name)
    return "PASS" if code&.zero?

    code ? format("exit=$%02x", code) : "timeout"
  end

  def run(filter, results_path)
    names = TESTS.select { |name| name.include?(filter) }
    results = names.map do |name|
      result = score(name)
      puts format("%-43<name>s %<result>s", name:, result:)
      $stdout.flush
      [name, result]
    end
    summarize(results, results_path)
  end

  def summarize(results, results_path)
    passed = results.count { |_, result| result == "PASS" }
    puts "#{passed}/#{results.length} passed"
    write_results(results_path, results) if results_path
    results.length - passed
  end

  def write_results(path, results)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, results.map { |name, result| record(name, result) }.join)
  end

  def record(name, result)
    result == "PASS" ? "#{name}\tPASS\n" : "#{name}\tFAIL\t#{result}\n"
  end
end

if $PROGRAM_NAME == __FILE__
  list_only = ARGV.delete("--list")
  results_path = SIDTests.take_option(ARGV, "--results")

  if list_only
    SIDTests::TESTS.each { |name| puts name }
    exit
  end

  exit(SIDTests.run(ARGV[0] || "", results_path).zero? ? 0 : 1)
end
