#!/usr/bin/env ruby
# frozen_string_literal: true

# Headless runner for the SID testprogs in vendor/VICE-testprogs/SID.
#
#   ruby --yjit bin/sidtests [filter...] [--list] [--results PATH]
#                            [--sid 6581|8580]
#
# Only the programs that report through the $D7FF debug register can be
# scored automatically ($00 pass, $ff fail); the rest print to the screen and
# need the eye. The machine is booted once, and each test runs in a child
# forked from it that injects the .prg and types RUN; a child that crashes
# or hangs gets a FAIL row saying so. Both lists are read from the
# testbench testlist, which tags the programs written for the 8580 sid-new
# and those for the 6581 sid-old, each with its own cycle budget; the 6581
# list also takes the untagged programs. With --results, the results log — one tab-separated "name STATUS
# [detail]" record per test, in test order — is written to PATH; that is the
# baseline format `rake regression:sid` diffs against the tracked copy in
# test/baselines/. Filters are name substrings matched as a union; one
# that matches nothing is an error rather than an empty run, so a typo
# cannot pass for a clean partial re-record. --sid picks the chip the
# machine is built with and the list it runs (default 6581); each chip has
# its own baseline, sid.txt and sid-8580.txt.

lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
require "badline"
require "fileutils"
require_relative "../test/forked_boot"

module SIDTests
  ROOT = File.expand_path("../vendor/VICE-testprogs/SID", __dir__)
  TESTLIST = File.expand_path("../vendor/VICE-testprogs/testbench/c64-testlist.in", __dir__)

  BOOT_ALLOWANCE = 3_000_000
  BATCH = 10_000

  SID_MODELS = { "6581" => :mos6581, "8580" => :mos8580 }.freeze

  module_function

  # Test names mapped to their cycle budget after boot.
  def tests(sid_model = :mos6581)
    File.readlines(TESTLIST).filter_map { |line| parse(line, sid_model) }.to_h
  end

  # A testlist row is "dir/,prg,type,cycles[,option...]". Only the exitcode
  # rows under SID/ are kept, as [name, cycles]: for the 8580 those tagged
  # sid-new, for the 6581 the rest. Rows that mount a disk image are left
  # out, since the runner only injects the .prg.
  def parse(line, sid_model = :mos8580)
    dir, prg, type, cycles, *options = line.strip.split(",")
    return unless dir&.start_with?("../SID/") && type == "exitcode"
    return if options.include?("sid-new") != (sid_model == :mos8580)
    return if options.any? { it.start_with?("mount") }

    ["#{dir.delete_prefix('../SID/')}#{prg}", Integer(cycles)]
  end

  # Removes "--name value" or "--name=value" from argv, returning the value.
  def take_option(argv, name)
    index = argv.index { |arg| arg == name || arg.start_with?("#{name}=") }
    return unless index

    arg = argv.delete_at(index)
    arg.start_with?("#{name}=") ? arg.split("=", 2).last : argv.delete_at(index)
  end

  def exit_code(computer, name, timeout)
    Badline::Media.attach(computer, File.join(ROOT, name))
    code = nil
    computer.install_debug_register { |value| code = value }
    BATCH.times { computer.cycle! } until code || computer.cycles > timeout + BOOT_ALLOWANCE
    code
  end

  # Each test runs in a child forked from a machine booted once per SID
  # model (see ForkedBoot). The deadline only catches a child stuck
  # outside its emulated cycles: at a hundred thousand cycles a second,
  # far slower than any machine this runs on, the budget alone would take
  # that long.
  def score(name, sid_model, timeout)
    deadline = 60 + ((timeout + BOOT_ALLOWANCE) / 100_000)
    booted(sid_model).run(deadline) do |computer|
      code = exit_code(computer, name, timeout)
      next "PASS" if code&.zero?

      code ? format("exit=$%02x", code) : "timeout"
    end
  end

  def booted(sid_model)
    @booted ||= {}
    @booted[sid_model] ||= ForkedBoot.new(%w[TERM INT]) { ForkedBoot.computer(sid_model:) }
  end

  # Filters are name substrings, matched as a union; no filter runs
  # everything.
  def selected(filters, tests = self.tests)
    return tests if filters.empty?

    tests.select { |name, _| filters.any? { |filter| name.include?(filter) } }
  end

  def unmatched(filters, tests = self.tests)
    filters.reject { |filter| tests.keys.any? { |name| name.include?(filter) } }
  end

  def run(tests, results_path, sid_model = :mos6581)
    width = tests.keys.map(&:length).max
    results = tests.map do |name, timeout|
      result = score(name, sid_model, timeout)
      puts "#{name.ljust(width)} #{result}"
      $stdout.flush
      [name, result]
    end
    summarize(results, results_path)
  end

  def summarize(results, results_path)
    passed = results.count { |_, result| result == "PASS" }
    puts "#{passed}/#{results.length} passed"
    write_results(results_path, results) if results_path
    results.length - passed
  end

  def write_results(path, results)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, results.map { |name, result| record(name, result) }.join)
  end

  def record(name, result)
    result == "PASS" ? "#{name}\tPASS\n" : "#{name}\tFAIL\t#{result}\n"
  end
end

if $PROGRAM_NAME == __FILE__
  list_only = ARGV.delete("--list")
  results_path = SIDTests.take_option(ARGV, "--results")
  sid_option = SIDTests.take_option(ARGV, "--sid") || "6581"
  sid_model = SIDTests::SID_MODELS.fetch(sid_option) do
    warn "sidtests: invalid argument: --sid #{sid_option}"
    exit 2
  end

  tests = SIDTests.tests(sid_model)
  unmatched = SIDTests.unmatched(ARGV, tests)
  unless unmatched.empty?
    warn "No test matches #{unmatched.join(', ')}."
    exit 2
  end

  tests = SIDTests.selected(ARGV, tests)

  if list_only
    tests.each_key { |name| puts name }
    exit
  end

  exit(SIDTests.run(tests, results_path, sid_model).zero? ? 0 : 1)
end
