#!/usr/bin/env ruby
# frozen_string_literal: true

# Headless runner for the SID testprogs in vendor/VICE-testprogs/SID.
#
#   ruby --yjit bin/sidtests [filter...] [--list] [--results PATH]
#                            [--sid 6581|8580]
#
# Only the programs that report through the $D7FF debug register can be
# scored automatically ($00 pass, $ff fail); the rest print to the screen and
# need the eye. The machine is booted once, and each test runs in a child
# forked from it that injects the .prg and types RUN; a child that crashes
# or hangs gets a FAIL row saying so. Both lists are read from the
# testbench testlist, which tags the programs written for the 8580 sid-new
# and those for the 6581 sid-old, each with its own cycle budget; both
# lists also take the untagged programs, which were written for either
# chip. With --results, the results log — one tab-separated "name STATUS
# [detail]" record per test, in test order — is written to PATH; that is the
# baseline format `rake regression:sid` diffs against the tracked copy in
# test/baselines/. Filters are name substrings matched as a union; one
# that matches nothing is an error rather than an empty run, so a typo
# cannot pass for a clean partial re-record. --sid picks the chip the
# machine is built with and the list it runs (default 6581); each chip has
# its own baseline, sid.txt and sid-8580.txt.
#
# Running a test on the machine lives in test/support/sidtests_machine.rb, which
# Spinel compiles too (spinel/sidtests.rb).

require_relative "../test/support/sidtests"

exit SIDTests.main(ARGV)
