module Badline
  module Chips
    class CPU
      @memory: C64::Bus
      @operation: Symbol
      @plan: Array[Symbol]
      @writes: Array[bool]
      @index: Integer
      @cycles: Integer
      @instructions: Integer
      @nmi: bool
      @nmi_sample: bool
      @nmi_pending: bool
      @skip_poll: bool
      @boundary_crossed: bool
      @brk: bool
      @so_high: bool
      @branch_taken: bool
      @a: Integer
      @x: Integer
      @y: Integer
      @stack_pointer: Integer
      @program_counter: Integer
      @address: Integer
      @pointer: Integer
      @dummy_address: Integer
      @value: Integer
      @rmw_result: Integer
      @ane_constant: Integer
      @irq: bool
      @irq_sample: bool
      @irq_pending: bool
      @boundary_irq: bool
      @boundary_nmi: bool
      @pending_write: bool
      @optional_dummy: bool

      class Microcode
        attr_accessor operation: Symbol
        attr_accessor plan: Array[Symbol]
      end
    end
  end

