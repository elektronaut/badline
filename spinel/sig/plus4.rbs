module Badline
  module Chips
    class TED
      @bus: Plus4::Bus
      @render: bool
      @registers: Array[Integer]
      @interrupt_flags: Integer
      @interrupt_mask: Integer
      @raster_compare: Integer
      @key_latch: Integer
      @blink: Integer
      @blink_on: bool
      @rom_selected: bool
      @timer_counts: Array[Integer]
      @timer_running: Array[bool]
      @timer1_reload: Integer
      @column: Integer
      @line: Integer
      @ba_low: bool
      @cpu_slots: Integer
      @patterns: Array[Integer]
      @pointers: Array[Integer]
      @attributes: Array[Integer]
      @fetched_attributes: Array[Integer]
      @char_position: Integer
      @line_position: Integer
      @row_line: Integer
      @row_active: bool
      @dma_kind: Integer
      @pattern_fetches: bool
      @scanline: Integer
      @window_open: bool
      @painted: Integer
      @display: Array[Integer]
      @dirty_lines: Array[bool]

      class Sound
        @time: Integer
        @frequencies: Array[Integer]
        @intervals: Array[Integer]
        @phases: Array[Integer]
        @next_toggles: Array[Integer]
        @noise: Integer
        @control: Integer
        @volume: Integer
        @level: Integer
        @reloading: bool
      end
    end

    class TIA
      @ports: Array[Integer]
      @directions: Array[Integer]
      @inputs: Array[Integer]
    end

    class ACIA
      @command: Integer
      @control: Integer
      @clock_hz: Integer
      @device: Integer
      @incoming: Array[Integer]
      @received: Array[Integer]
      @errors: Integer
      @receiver_full: bool
      @transmitter_empty: bool
      @irq: bool
      @receive_data: Integer
      @transmit_data: Integer
      @shifting: Integer
      @transmit_at: Integer
      @transmit_remainder: Integer
      @receive_at: Integer
      @receive_remainder: Integer
      @clock_lost: bool
      @lines: Integer
      @due: Integer

      def take: (Integer) -> void

      module Frames
        @command: Integer
        @control: Integer
        @clock_hz: Integer
        @transmit_remainder: Integer
        @receive_remainder: Integer
      end
    end
  end

  module Drives
    class Datasette
      @level: bool
      @playing: bool
      @motor: bool
      @countdown: Integer
      @rise_at: Integer
      @low_recorded: bool
      @recording: bool
      @since: Integer
      @write_high: bool
    end
  end

  class Plus4
    @cycles: Integer
    @acia_due: Integer
    @acia_irq: bool

    class CPUPort
      @ddr: Integer
      @data: Integer
    end

    class KeyboardPort
      @output: Integer
    end

    class UserPort
      @output: Integer
      @inputs: Integer
    end

    class SIDCard
      @clocked: Integer
      @address: Integer
    end

    class RAMExpansion
      @control: Integer
      @csory_latch: Integer
      @mask: Integer
      @csory: bool
      @banks: Array[Bus::MirroredRAM]
      @blocks: Array[Bus::MirroredRAM]
    end

    class Bus
      @start: Integer
      @length: Integer
      @end: Integer
      @low_bank: Integer
      @high_bank: Integer
      @data: Integer
      @rom_selected: bool
      @cpu_ram: Array[MirroredRAM]
      @ted_ram: Array[MirroredRAM]
      @top_ram: MirroredRAM

      class MirroredRAM
        @mask: Integer
        @offset: Integer
      end

      class ZeroPage
        @ram: MirroredRAM
      end

      class IOPage
        @bus: Plus4::Bus
        @ram_expansion: Plus4::RAMExpansion
      end
    end
  end
end
