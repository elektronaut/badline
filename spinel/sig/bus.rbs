module Badline
  class Memory
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
    def []=: (Integer, Integer) -> void
  end

  class ColorMemory
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
    def nibble: (Integer) -> Integer
  end

  class ROM
    def poke: (Integer, Integer) -> void
  end

  class AddressBus
    @port_ddr: Integer
    @port_out: Integer
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void

    class OpenBus
      def peek: (Integer) -> Integer
      def poke: (Integer, Integer) -> void
    end

    class SIDSlots
      def peek: (Integer) -> Integer
      def poke: (Integer, Integer) -> void
    end
  end

  class DebugRegister
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
  end

  class VIC
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
    def phi1_data: () -> Integer

    class Bank
      def peek: (Integer) -> Integer
      def peek_phi2: (Integer) -> Integer
      def peek_color: (Integer) -> Integer
    end
  end

  class CIA
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
  end

  class SID
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
  end

  class REU
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void

    class Trigger
      def peek: (Integer) -> Integer
      def poke: (Integer, Integer) -> void
    end
  end

  class Vic20
    class Bus
      @data: Integer
      @video_data: Integer
      def peek: (Integer) -> Integer
      def poke: (Integer, Integer) -> void

      class OpenBus
        def peek: (Integer) -> Integer
        def poke: (Integer, Integer) -> void
      end

      class VideoOpenBus
        def peek: (Integer) -> Integer
        def poke: (Integer, Integer) -> void
      end

      class ColorRAM
        def peek: (Integer) -> Integer
        def poke: (Integer, Integer) -> void
        def nibble: (Integer) -> Integer
      end

      class IO0
        def peek: (Integer) -> Integer
        def poke: (Integer, Integer) -> void
      end
    end

    class VIC
      @bus: Bus
      @ram: Memory
      @character_rom: ROM
      @color_ram: Bus::ColorRAM
      @render: bool
      def peek: (Integer) -> Integer
      def poke: (Integer, Integer) -> void
      def connect: (Bus) -> void
      def video_read: (Integer) -> Integer
      def render=: (bool) -> void
      def draw: (Integer) -> void
      def draw_group: (Integer, Integer) -> void
      def draw_pixels: (Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer) -> void
      def finish_line: () -> void
      def clear_dirty_lines!: () -> void
    end
  end
end
