module Badline
  class Memory
    @storage: Array[Integer]
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
    def []=: (Integer, Integer) -> void
  end

  class ColorMemory
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
    def nibble: (Integer) -> Integer
  end

  class ROM
    def poke: (Integer, Integer) -> void
  end

  class AddressBus
    @port_ddr: Integer
    @port_out: Integer
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void

    class OpenBus
      def peek: (Integer) -> Integer
      def poke: (Integer, Integer) -> void
    end

    class SIDSlots
      def peek: (Integer) -> Integer
      def poke: (Integer, Integer) -> void
    end
  end

  class DebugRegister
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
  end

  class VIC
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
    def phi1_data: () -> Integer

    class Bank
      def peek: (Integer) -> Integer
      def peek_phi2: (Integer) -> Integer
      def peek_color: (Integer) -> Integer
    end
  end

  class CIA
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
  end

  class SID
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void
  end

  class REU
    def peek: (Integer) -> Integer
    def poke: (Integer, Integer) -> void

    class Trigger
      def peek: (Integer) -> Integer
      def poke: (Integer, Integer) -> void
    end
  end

  class Vic20
    class Bus
      @data: Integer
      @video_data: Integer
      def peek: (Integer) -> Integer
      def poke: (Integer, Integer) -> void

      class OpenBus
        def peek: (Integer) -> Integer
        def poke: (Integer, Integer) -> void
      end

      class VideoOpenBus
        def peek: (Integer) -> Integer
        def poke: (Integer, Integer) -> void
      end

      class ColorRAM
        def peek: (Integer) -> Integer
        def poke: (Integer, Integer) -> void
        def nibble: (Integer) -> Integer
      end

      class IO0
        def peek: (Integer) -> Integer
        def poke: (Integer, Integer) -> void
      end
    end

    class VIC
      @bus: Bus
      @stale: Array[bool]
      @cycles_per_line: Integer
      @lines_per_frame: Integer
      @origin_x: Integer
      @origin_y: Integer
      @columns: Integer
      @rows: Integer
      @char_shift: Integer
      @screen_base: Integer
      @char_base: Integer
      @fetch_from: Integer
      @fetch_to: Integer
      @matrix: Integer
      @row_start: Integer
      @char_line: Integer
      @text_rows: Integer
      @window_open: bool
      @window_done: bool
      def connect: (Bus) -> void
      def render=: (bool) -> void
      def peek: (Integer) -> Integer
      def poke: (Integer, Integer) -> void

      class Painter
        @render: bool
        @reverse: bool
        @written: bool
        @stale: Array[bool]
        @dirty_lines: Array[bool]
        def render=: (bool) -> void
      end
    end
  end
end
